# Slack API Token (Bot User OAuth Token)
# Required scopes: channels:history, chat:write, channels:manage, users:read
SLACK_API_TOKEN=xoxb-your-slack-bot-token

# Optional: Slack channel ID to sync. Defaults to the #fredagslistan production
# channel when unset; override to point at a test channel.
SLACK_CHANNEL_ID=

# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your-spotify-client-id
SPOTIPY_CLIENT_SECRET=your-spotify-client-secret
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback

# Optional: refresh token for headless auth (used by CI instead of a .cache
# file). Leave unset locally to use the interactive OAuth flow. See the README
# "Spotify auth & token rotation" section for how to mint and rotate this.
SPOTIPY_REFRESH_TOKEN=
